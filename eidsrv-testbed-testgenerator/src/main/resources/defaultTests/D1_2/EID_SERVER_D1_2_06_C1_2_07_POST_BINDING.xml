	<p:name>EID_SERVER_D1_2_06_C1_2_07_POST_BINDING</p:name>
	<p:description>This test checks the behaviour of the eID-Server at the eIDAS-Interface in case of a secure messaging error during Online-Authentication.</p:description>
	<p:modulePath>
		<p:node>D</p:node>
		<p:node>1</p:node>
		<p:node>2</p:node>
