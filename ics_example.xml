	<Cryptography>
		<SAML>
			<XmlSignature>
				<Signature URI="http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256">
					<Digest>http://www.w3.org/2001/04/xmlenc#sha256</Digest>
					<Canonicalization>http://www.w3.org/2001/10/xml-exc-c14n#</Canonicalization>
					<Parameters>
						<NamedCurve>secp256r1</NamedCurve>
					</Parameters>
				</Signature>
				<Signature URI="http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha384">
					<Digest>http://www.w3.org/2001/04/xmldsig-more#sha384</Digest>
					<Canonicalization>http://www.w3.org/2001/10/xml-exc-c14n#</Canonicalization>
					<Parameters>
						<NamedCurve>secp384r1</NamedCurve>
					</Parameters>
				</Signature>
			</XmlSignature>
			<XmlEncryption>
				<KeyTransportAlgorithms>
					<TransportAlgorithm URI="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p">
						<Parameter>3072</Parameter>
					</TransportAlgorithm>
					<TransportAlgorithm URI="http://www.w3.org/2009/xmlenc11#rsa-oaep">
						<Parameter>3072</Parameter>
					</TransportAlgorithm>
				</KeyTransportAlgorithms>
				<KeyAgreementAlgorithms>
					<AgreementAlgorithm URI="http://www.w3.org/2009/xmlenc11#ECDH-ES">
						<Parameters>
							<NamedCurve>secp256r1</NamedCurve>
							<NamedCurve>secp384r1</NamedCurve>
							<NamedCurve>secp521r1</NamedCurve>
						</Parameters>
						<KeyWrappingUri>http://www.w3.org/2001/04/xmlenc#kw-aes256</KeyWrappingUri>
					</AgreementAlgorithm>
					<AgreementAlgorithm URI="http://www.w3.org/2009/xmlenc11#ECDH-ES">
						<Parameters>
							<NamedCurve>secp256r1</NamedCurve>
							<NamedCurve>secp384r1</NamedCurve>
							<NamedCurve>secp521r1</NamedCurve>
						</Parameters>
						<KeyWrappingUri>http://www.w3.org/2001/04/xmlenc#kw-aes128</KeyWrappingUri>
					</AgreementAlgorithm>
				</KeyAgreementAlgorithms>
				<ContentEncryptionAlgorithms>
					<URI>http://www.w3.org/2009/xmlenc11#aes256-gcm</URI>
					<URI>http://www.w3.org/2009/xmlenc11#aes192-gcm</URI>
					<URI>http://www.w3.org/2009/xmlenc11#aes128-gcm</URI>
				</ContentEncryptionAlgorithms>
			</XmlEncryption>
		</SAML>
		<eIDAS>
			<XmlSignature>
				<Signature URI="http://www.w3.org/2007/05/xmldsig-more#sha256-rsa-MGF1">
					<Digest>http://www.w3.org/2001/04/xmlenc#sha256</Digest>
					<Canonicalization>http://www.w3.org/TR/2001/REC-xml-c14n-20010315</Canonicalization>
					<Parameters>
						<BitLength>3072</BitLength>
						<BitLength>4096</BitLength>
					</Parameters>
				</Signature>
				<Signature URI="http://www.w3.org/2007/05/xmldsig-more#sha384-rsa-MGF1">
					<Digest>http://www.w3.org/2001/04/xmlenc#sha256</Digest>
					<Canonicalization>http://www.w3.org/TR/2001/REC-xml-c14n-20010315</Canonicalization>
