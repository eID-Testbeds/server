	<Metadata>
		<eCardApiUrl>https://eidas-host/eidas-middleware/paosreceiver</eCardApiUrl>
		<eIdInterfaceiUrl>https://eidas-host/POSeIDAS/eID</eIdInterfaceiUrl>
